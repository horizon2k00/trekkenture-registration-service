DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=trekkenture
DB_LOGGING=false

JWT_SECRET=generate-a-long-random-secret
JWT_EXPIRES_IN=8h
ADMIN_USERNAME=admin
# Keep the original in your ignored .env; the API hashes it in memory at startup.
ADMIN_PASSWORD=choose-a-local-admin-password

UPI_ID=pay.trekkenture@okaxis
UPI_PAYEE_NAME=Trekkenture
UPI_CURRENCY=INR

# Email is disabled when these are blank.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Trekkenture Team" <noreply@trekkenture.com>

NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001
